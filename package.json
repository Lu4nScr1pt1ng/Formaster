    "@codemirror/view": "^6.43.6",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "codemirror": "^6.0.2",
    "pdf-lib": "^1.17.1",
    "phosphor-svelte": "^3.1.0",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
